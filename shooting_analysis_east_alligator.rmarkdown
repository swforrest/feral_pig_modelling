### Summarise the shooting hits

```{r}

# summarise per shooting event
hits %>% 
  st_drop_geometry()  %>% 
  count(shoot_id, name = "n_pig_points")

# summarise per GPS location
pig_GPS_hits <- hits %>% 
  st_drop_geometry()  %>% 
  count(pig_row, name = "n_shooting_hits")

pig_GPS_hits

pig_all_steps_sf_shoot <- left_join(pig_all_steps_sf, pig_GPS_hits, by = "pig_row")

pig_all_steps_sf_shoot <- pig_all_steps_sf_shoot %>% 
  mutate(
    n_shooting_hits = ifelse(is.na(n_shooting_hits), 0, n_shooting_hits),
    shooting_hit = ifelse(n_shooting_hits > 0, TRUE, FALSE)
  )

```

### Summary of shooting hits

```{r}

pig_all_steps_sf_shoot %>% filter(shooting_hit == TRUE)

pig_all_steps_sf_shoot %>% st_drop_geometry() %>%
  filter(shooting_hit == TRUE) %>% 
  summarise(
    mean_hour = mean(hour, na.rm = TRUE),
  )

```

## Plotting shooting info

```{r}

pig_all_steps_sf_shoot %>%        
  filter(dt_hour < 0.75) %>% # keep the half-hour locations
  ggplot(aes(x = as.factor(shooting_hit), y = sl_, colour = n_shooting_hits)) +
  geom_jitter(alpha = 0.1) +
  geom_violin(alpha = 0) +
  scale_y_continuous("Step length (m)") +
  coord_cartesian(ylim = c(0, 200)) +
  theme_bw() 

```



