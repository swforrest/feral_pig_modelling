landcover_cropped <- landcover %>% 
  st_transform(crs = 3112) %>% 
  st_crop(pig_aoi) 

```

### Plot the landcover data

```{r}

ggplot() +
  geom_sf(data = landcover_cropped, aes(fill = Veg_class), colour = NA) + 
  geom_sf(data = pig_all_steps_sf, aes(colour = season),
          size = 0.1) + #aes(colour = name), colour = "black", , alpha = 0.1
  coord_sf() +
  scale_fill_viridis_d("Vegetation Class") + #option = "H"
  scale_colour_manual(
    "Season",
    values = c("wet" = "skyblue", "dry" = "orange"),
    labels = c("wet" = "Wet season", "dry" = "Dry season")) +
  theme_bw() + 
