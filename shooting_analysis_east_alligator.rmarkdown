# Assess selection of covariates through time

## Landcover variables

::: {.panel-tabset}

## Floodplain Sedgeland

### Hourly

```{r}

n_names <- n_distinct(pig_all_steps_covs$name)
viridis_cols <- viridisLite::viridis(n_names)

pig_all_steps_covs %>% 
  ggplot() +
  geom_smooth(aes(x = hour, y = veg_floodplain_sedgeland, colour = name, fill = name),
              alpha = 0.15,
              method = "gam", se = T) +
  geom_smooth(data = pig_all_steps_covs %>% filter(season == "wet"),
              aes(x = hour, y = veg_floodplain_sedgeland),
              method = "gam", se = T,
              alpha = 0.5, linewidth = 2, fill = "skyblue", colour = "skyblue") +
  geom_smooth(data = pig_all_steps_covs %>% filter(season == "dry"),
              aes(x = hour, y = veg_floodplain_sedgeland),
              method = "gam", se = T,
              alpha = 0.5, linewidth = 2, fill = "orange", colour = "orange") +
  scale_colour_manual(values = scales::alpha(viridis_cols, 0.1)) +
  scale_fill_manual(values = viridis_cols) +
  coord_cartesian(ylim = c(0, 1)) +
  scale_y_continuous("Proportional use (0 to 1)") +
  theme_bw() +
  theme(legend.position = "none")

ggsave("outputs/east_alligator_hourly_floodplain_sedgeland.png", 
       width = 250, height = 150, units = "mm", scale = 0.75, dpi = 600)

```

